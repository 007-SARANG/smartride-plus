# Environment Variables Template
# Copy this to .env.local and fill in your API keys

# ============================================
# MAPBOX (Required for maps)
# ============================================
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

# ============================================
# MOBILITY DATA API (Real GPS Tracking) ✅ READY!
# ============================================
# Already configured in code with your API key
# You can override it here if needed
MOBILITY_DATA_API_KEY=AMf-vBwsJVxl4LFLVidoHhPgmeSczP9NTcs_xjnC0HFk3xAtT8cT4YDIz5qDh4i8x1oUbSqABGEkwPg_3OSYlfIbvYgbxqJJFUYPvI0gpAck-weFAq0YmUXl0L6kqYDlWa8ptSOnjHffOaXBL5tvxXHXy8sgsIGTXkinvGt0iFV8ME2TO72mKCoE1QPSgqkrUHU3p0n5nl4Zd1U9jESH9kVja80EOevYIrPfS_SJV4UhNVPY1aaK2r4

# ============================================
# INDIAN TRANSIT APIS (Optional - Direct access)
# ============================================
# Delhi Open Transit Data
# Get key from: https://otd.delhi.gov.in/
DELHI_OTD_API_KEY=

# Bangalore BMTC
# Get key from: https://www.mybmtc.com/contact/api-access
BMTC_API_KEY=

# Mumbai BEST
# Contact: itdept@bestundertaking.com
NEXT_PUBLIC_BEST_API_KEY=

# ============================================
# GOOGLE MAPS (Optional - Enhanced features)
# ============================================
# Get key from: https://console.cloud.google.com/
# Enable: Directions API, Places API, Transit API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ============================================
# FIREBASE (Optional - For database)
# ============================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ============================================
# NOTES
# ============================================
# - Never commit .env.local to git (already in .gitignore)
# - All NEXT_PUBLIC_ vars are exposed to browser
# - Server-only secrets should NOT have NEXT_PUBLIC_ prefix
# - Restart dev server after changing env vars
